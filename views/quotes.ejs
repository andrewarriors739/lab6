<!DOCTYPE html>
<html lang="en">
<%- include ('partials/head.ejs') %>
<body>

    <h1 class="text-center"> Famous Quotes </h1>

    <nav class="text-center"> <a href="/"> Home </a></nav>

    <div class="container">
      <% for (let i of rows) { %>
        <div>
          <i class="fs-5"> <%= i.quote %> </i><br>
          <span
            class="author-link text-decoration-underline"
            data-author-id="<%= i.authorId %>"
          >
            <%= i.firstName %> <%= i.lastName %>
          </span>
          <br><br>
        </div>
      <% } %>
    </div>

    <%- include ('partials/footer.ejs') %>

    <div
      class="modal fade"
      id="authorModal"
      tabindex="-1"
      aria-labelledby="authorModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="authorModalLabel">Author Info</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <div class="text-center mb-3">
              <img
                id="authorImage"
                src=""
                alt="Author Photo"
                class="img-fluid rounded"
                style="max-height: 300px;"
              />
            </div>
            <p><strong>Name:</strong> <span id="authorFullName"></span></p>
            <p><strong>Author ID:</strong> <span id="authorId"></span></p>
            <p><strong>Date of Birth:</strong> <span id="authorDob"></span></p>
            <p><strong>Date of Death:</strong> <span id="authorDod"></span></p>
            <p><strong>Sex:</strong> <span id="authorSex"></span></p>
            <p><strong>Profession:</strong> <span id="authorProfession"></span></p>
            <p><strong>Country:</strong> <span id="authorCountry"></span></p>
            <p><strong>Biography:</strong> <span id="authorBio"></span></p>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".author-link").forEach(link => {
          link.addEventListener("click", async () => {
            const authorId = link.dataset.authorId;

            const res = await fetch(`/authorInfo?authorId=${authorId}`);
            const data = await res.json();

            if (data.error) {
              alert(data.error);
              return;
            }

            document.getElementById("authorFullName").textContent = data.firstName + " " + data.lastName;
            document.getElementById("authorId").textContent = data.authorId;
            document.getElementById("authorDob").textContent = data.dob;
            document.getElementById("authorDod").textContent = data.dod ? data.dod : "N/A";
            document.getElementById("authorSex").textContent = data.sex;
            document.getElementById("authorProfession").textContent = data.profession;
            document.getElementById("authorCountry").textContent = data.country;
            document.getElementById("authorBio").textContent = data.biography;
            document.getElementById("authorImage").src = data.portrait;

            new bootstrap.Modal(document.getElementById("authorModal")).show();
          });
        });
      });
    </script>
</body>
</html>