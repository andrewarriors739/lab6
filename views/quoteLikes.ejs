<!DOCTYPE html>
<html lang="en">
<%- include ('partials/head.ejs') %>
<body>

    <h1 class="text-center"> Famous Quotes </h1>

    <nav class="text-center"> <a href="/"> Home </a></nav>
    
    <div class="container">

        <% for (let i of rows) { %> 
          <i class="fs-5"> <%= i.quote %> </i><br>
          <%= i.firstName %> <%= i.lastName %> <br>
          Likes: <%= i.likes %><br><br>
        <% } %>

    </div>

    <%- include ('partials/footer.ejs') %>
</body>
</html>